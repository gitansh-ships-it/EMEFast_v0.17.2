# EMEFast FastAPI Backend Configuration
ENVIRONMENT=development
DEMO_MODE=0
PORT=8000
CORS_ORIGINS=https://frontend-v2-seven-chi.vercel.app,http://localhost:3000,http://localhost:3001
JWT_SECRET=emefast-local-dev-jwt-secret-replace-in-production

# Database (SQLite for local dev; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///emefast.db
# DATABASE_URL=postgresql+asyncpg://user:password@host/emefast_db

# Voice Storage ('local' or 's3')
STORAGE_BACKEND=local
# S3_BUCKET_NAME=emefast-emergency-voice
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-key-id
# Optional Seed User Passwords (only if seeding accounts on fresh instance)
# SEED_ADMIN_PASSWORD=your-secure-admin-password
# SEED_HOSPITAL_PASSWORD=your-secure-hospital-password
# SEED_USER_PASSWORD=your-secure-ambulance-password
