# Deployment values for Vercel and Render

# Vercel Frontend:
NEXT_PUBLIC_API_URL=https://emefast-v17.onrender.com/api

# Render FastAPI Backend:
ENVIRONMENT=production
DEMO_MODE=0
CORS_ORIGINS=https://frontend-v2-seven-chi.vercel.app
JWT_SECRET=your-random-production-jwt-secret-min-32-chars
DATABASE_URL=postgresql+asyncpg://user:password@host/emefast_db

# Voice Storage:
STORAGE_BACKEND=local
# S3_BUCKET_NAME=emefast-emergency-voice
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-key
